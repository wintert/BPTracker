<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Allow-only, same as backup_rules.xml: the readings and their photos transfer,
         and the encrypted API key stays on this device because it is simply not listed.
         The key is also device-bound via the Android keystore, so a copied file would be
         useless elsewhere regardless. -->
    <cloud-backup>
        <include domain="database" path="bp-tracker.db" />
        <include domain="file" path="reading_photos/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="bp-tracker.db" />
        <include domain="file" path="reading_photos/" />
    </device-transfer>
</data-extraction-rules>
