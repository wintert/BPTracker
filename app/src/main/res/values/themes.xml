<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose paints the real UI; this theme only governs the window background shown
         before the first frame. It is qualified by values-night/ so that moment matches
         the Compose palette instead of flashing white on a dark-mode phone.
         (There is no android:Theme.DeviceDefault.DayNight.* in the framework, and pulling
         in AppCompat just for Theme.AppCompat.DayNight isn't worth a dependency.) -->
    <style name="Theme.BpTracker" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
