<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Only needed for AI extraction, which is optional. Everything else works offline. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Morning/evening prompts. Runtime-requested on Android 13+; declining costs only
         the reminders, never the app. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Re-arms the daily alarms after a restart, which otherwise silently drops them. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Reminders must land at the minute the user picked. Inexact alarms were tried first
         and measurably did not fire: Android batches long-interval inexact alarms into
         power-chosen windows, so an alarm set for 15:51 sat undelivered.
         USE_EXACT_ALARM (API 33+) is granted at install with no prompt; SCHEDULE_EXACT_ALARM
         covers API 31-32, where the user may have to allow it in system settings. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />

    <!-- Taking a photo of the monitor. Declared optional so the app installs on any device. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:name=".BpApplication"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.BpTracker">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.BpTracker">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".reminder.ReminderReceiver"
            android:exported="false" />

        <receiver
            android:name=".reminder.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Hands the system camera a file to write into, without exposing a file:// URI. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
